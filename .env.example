# ReviewPilot AI - environment configuration
# Copy to `.env` and fill in values. `.env` is git-ignored: never commit real secrets.

# --- Application -----------------------------------------------------------------
ENVIRONMENT=local                  # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000 # comma-separated
DEMO_MODE=false                    # labelled demo data; refused in staging/production

# --- Security (REQUIRED outside local/test) ------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate: the first encrypts, all decrypt.
ENCRYPTION_KEY=
# Rate limits (per minute; 0 disables one limit). Writes and review actions are per session,
# webhooks per source IP. Behind a proxy, run uvicorn with --proxy-headers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITES_PER_MINUTE=120
RATE_LIMIT_REVIEW_ACTIONS_PER_MINUTE=10
RATE_LIMIT_WEBHOOKS_PER_MINUTE=1000
# A signed webhook body re-sent under a new delivery id within this window is ignored.
WEBHOOK_REPLAY_WINDOW_HOURS=72

# --- PostgreSQL / Redis (docker compose) ----------------------------------------
POSTGRES_USER=reviewpilot
POSTGRES_PASSWORD=reviewpilot
POSTGRES_DB=reviewpilot
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
WORKER_CONCURRENCY=2

# --- GitHub App (see docs/github-integration.md) --------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Private key: save the downloaded .pem as ./secrets/github-app.pem (git-ignored).
# Docker Compose mounts it automatically; this path is for running the backend on the host
# (relative to backend/). Alternatively set GITHUB_APP_PRIVATE_KEY to the PEM with literal \n.
GITHUB_APP_PRIVATE_KEY_PATH=../secrets/github-app.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Local development webhook relay (https://smee.io/new); GitHub cannot reach localhost.
SMEE_URL=
# OAuth credentials of the same GitHub App (used for "Sign in with GitHub").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Post reviews to GitHub (false = dry run: reviews only visible in ReviewPilot).
GITHUB_PUBLISH_ENABLED=true
PUBLISH_MAX_INLINE_COMMENTS=25     # extra findings go into the summary

# --- AI providers ------------------------------------------------------------
# `openai` means ANY OpenAI-compatible endpoint, including free ones. Free presets:
#
#   Ollama (local, free, private; install from ollama.com, then `ollama pull qwen2.5-coder:7b`)
#     LLM_PROVIDER=openai
#     OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # from Docker; host-run: http://localhost:11434/v1
#     OPENAI_API_KEY=ollama                                   # any non-empty value
#     OPENAI_MODEL=qwen2.5-coder:7b
#     LLM_TOKENS_PER_MINUTE=0
#
#   Google Gemini (free tier; key from aistudio.google.com; free-tier data may be used by Google)
#     LLM_PROVIDER=openai
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENAI_API_KEY=<your Gemini key>
#     OPENAI_MODEL=<a current Flash model name>
#
#   Groq (free tier with rate limits; key from console.groq.com)
#     LLM_PROVIDER=openai
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_API_KEY=<your Groq key>
#     OPENAI_MODEL=<a current Llama/Qwen model name>
#
LLM_PROVIDER=mock                  # mock | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high             # low | medium | high | xhigh | max
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
OPENAI_MODEL=gpt-4o-mini
# Extra models on the same provider (spread load / fallback), a fast model for summaries,
# and a per-model tokens-per-minute budget (0 = unlimited; Groq free tier ~8000).
LLM_FALLBACK_MODELS=
LLM_FAST_MODEL=
LLM_TOKENS_PER_MINUTE=0

# --- AI review engine -------------------------------------------------------
AI_REVIEW_ENABLED=true
AI_REVIEWERS=security,bugs,performance,quality
AI_MAX_INPUT_TOKENS=3000           # per LLM call
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_BATCHES_PER_REVIEWER=3
AI_VERIFY_FINDINGS=true            # second-pass LLM validation
AI_MIN_CONFIDENCE_FLOOR=0.75       # minimum confidence for AI findings

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
